<mujoco model="waterboard_robot">
  <compiler angle="radian" meshdir="meshes" texturedir="textures"/>
  <option timestep="0.002" gravity="0 0 -9.81"/>
  <default>
    <joint damping="0.1" armature="0.01"/>
    <geom friction="0.5 0.005 0.0001" condim="3" density="1000"/>
  </default>
  <asset>
    <material name="board_mat" rgba="0.2 0.4 0.8 1" specular="0.5"/>
    <material name="wheel_mat" rgba="0.1 0.1 0.1 1" specular="0.9"/>
  </asset>
  <worldbody>
    <geom name="floor" type="plane" size="30 30 0.1" condim="3" material="board_mat"/>
    <geom name="water" type="box" size="30 30 0.05" pos="0 0 -0.02" rgba="0 0.3 0.8 0.3" contype="0" conaffinity="0"/>
    <body name="board" pos="0 0 0.2">
      <freejoint/>
      <geom name="board_body" type="box" size="0.5 0.2 0.05" material="board_mat"/>
      <body name="wheel_left" pos="-0.45 0 0">
        <geom name="wheel_left_geom" type="cylinder" size="0.04 0.02" material="wheel_mat"/>
        <joint name="wheel_left_hinge" type="hinge" axis="0 1 0" limited="false"/>
      </body>
      <body name="wheel_right" pos="0.45 0 0">
        <geom name="wheel_right_geom" type="cylinder" size="0.04 0.02" material="wheel_mat"/>
        <joint name="wheel_right_hinge" type="hinge" axis="0 1 0" limited="false"/>
      </body>
    </body>
  </worldbody>
  <actuator>
    <motor name="left_motor" joint="wheel_left_hinge" gear="50" ctrllimited="true" ctrlrange="-10 10"/>
    <motor name="right_motor" joint="wheel_right_hinge" gear="50" ctrllimited="true" ctrlrange="-10 10"/>
  </actuator>
</mujoco>