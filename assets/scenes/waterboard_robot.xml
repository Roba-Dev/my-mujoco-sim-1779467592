<mujoco model="waterboard_robot">
  <compiler angle="radian" eulerseq="xyz" meshdir="meshes" texturedir="textures"/>
  <option timestep="0.002" gravity="0 0 -9.81" iterations="50"/>
  <default>
    <geom type="capsule" size="0.05 0.2" mass="0.2" friction="1 0.005 0.0001" condim="3"/>
    <motor gear="100" ctrllimited="true" ctrlrange="-1 1"/>
  </default>
  <asset>
    <material name="board_mat" rgba="0.1 0.4 0.8 1"/>
  </asset>
  <worldbody>
    <geom name="floor" type="plane" size="20 20 0.1" condim="3" material="board_mat"/>
    <body name="board" pos="0 0 0.6">
      <!-- slide joint provides vertical actuation; no freejoint to stay within 6 DOFs -->
      <joint name="thruster_joint" type="slide" axis="0 0 1" range="-0.5 0.5" damping="0.1"/>
      <geom name="board_geom" type="box" size="0.5 0.2 0.05" material="board_mat" mass="5"/>
    </body>
  </worldbody>
  <actuator>
    <motor name="thruster" joint="thruster_joint" gear="800" ctrllimited="true" ctrlrange="-1 1"/>
  </actuator>
</mujoco>
