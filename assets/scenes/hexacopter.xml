<?xml version="1.0" ?>
<mujoco model="hexacopter">
  <compiler angle="degree" coordinate="local" />
  <option timestep="0.002" gravity="0 0 -9.81" />
  <default>
    <joint type="hinge" limited="false" damping="0.1" />
    <geom type="cylinder" size="0.02 0.2" material="metal" rgba="0.8 0.8 0.8 1" contype="0" conaffinity="0" />
  </default>
  <asset>
    <material name="metal" rgba="0.7 0.7 0.7 1"/>
  </asset>

  <worldbody>
    <body name="central_body" pos="0 0 0.1">
      <freejoint name="freejoint" />
      <inertial pos="0 0 0" mass="1" diaginertia="0.01 0.01 0.01" />
      <!-- Arms -->
      <body name="arm0_body" pos="0 0 0">
        <joint name="arm0_joint" type="hinge" axis="0 0 1" />
        <geom name="arm0_geom" type="cylinder" fromto="0 0 0 0.4 0 0" size="0.02 0.4" />
        <body name="prop0_body" pos="0.4 0 0">
          <geom name="prop0_geom" type="sphere" size="0.05" rgba="0.9 0.1 0.1 1" />
        </body>
      </body>
      <body name="arm1_body" pos="0 0 0" euler="0 0 60">
        <joint name="arm1_joint" type="hinge" axis="0 0 1" />
        <geom name="arm1_geom" type="cylinder" fromto="0 0 0 0.4 0 0" size="0.02 0.4" />
        <body name="prop1_body" pos="0.4 0 0">
          <geom name="prop1_geom" type="sphere" size="0.05" rgba="0.1 0.9 0.1 1" />
        </body>
      </body>
      <body name="arm2_body" pos="0 0 0" euler="0 0 120">
        <joint name="arm2_joint" type="hinge" axis="0 0 1" />
        <geom name="arm2_geom" type="cylinder" fromto="0 0 0 0.4 0 0" size="0.02 0.4" />
        <body name="prop2_body" pos="0.4 0 0">
          <geom name="prop2_geom" type="sphere" size="0.05" rgba="0.1 0.1 0.9 1" />
        </body>
      </body>
      <body name="arm3_body" pos="0 0 0" euler="0 0 180">
        <joint name="arm3_joint" type="hinge" axis="0 0 1" />
        <geom name="arm3_geom" type="cylinder" fromto="0 0 0 0.4 0 0" size="0.02 0.4" />
        <body name="prop3_body" pos="0.4 0 0">
          <geom name="prop3_geom" type="sphere" size="0.05" rgba="0.9 0.9 0.1 1" />
        </body>
      </body>
      <body name="arm4_body" pos="0 0 0" euler="0 0 240">
        <joint name="arm4_joint" type="hinge" axis="0 0 1" />
        <geom name="arm4_geom" type="cylinder" fromto="0 0 0 0.4 0 0" size="0.02 0.4" />
        <body name="prop4_body" pos="0.4 0 0">
          <geom name="prop4_geom" type="sphere" size="0.05" rgba="0.9 0.1 0.9 1" />
        </body>
      </body>
      <body name="arm5_body" pos="0 0 0" euler="0 0 300">
        <joint name="arm5_joint" type="hinge" axis="0 0 1" />
        <geom name="arm5_geom" type="cylinder" fromto="0 0 0 0.4 0 0" size="0.02 0.4" />
        <body name="prop5_body" pos="0.4 0 0">
          <geom name="prop5_geom" type="sphere" size="0.05" rgba="0.1 0.9 0.9 1" />
        </body>
      </body>
    </body>
  </worldbody>

  <actuator>
    <motor name="motor0" joint="arm0_joint" ctrlrange="-500 500" gear="100" />
    <motor name="motor1" joint="arm1_joint" ctrlrange="-500 500" gear="100" />
    <motor name="motor2" joint="arm2_joint" ctrlrange="-500 500" gear="100" />
    <motor name="motor3" joint="arm3_joint" ctrlrange="-500 500" gear="100" />
    <motor name="motor4" joint="arm4_joint" ctrlrange="-500 500" gear="100" />
    <motor name="motor5" joint="arm5_joint" ctrlrange="-500 500" gear="100" />
  </actuator>
</mujoco>
